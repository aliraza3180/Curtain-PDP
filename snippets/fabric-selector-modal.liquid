{% comment %}
  Fabric & Colour Selector Modal
  Reads from product metafield: custom.fabric_colours (list of metaobject refs)
  Each metaobject = Fabric Colour with fields:
    fabric_name, colour_name, swatch_color, swatch_image, fabric_image, fabric_code, sort_order
{% endcomment %}

<!-- Modal Overlay -->
<div class="cc-modal-overlay" id="cc-modal-overlay" aria-hidden="true"></div>

<!-- Modal -->
<div
  class="cc-modal"
  id="cc-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Choose fabric and colour"
>
<button class="cc-modal__close" id="cc-modal-close" type="button" aria-label="Close modal">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="cc-modal__body">
    <div class="cc-modal__fabrics">
      <div class="cc-modal__section-title">Choose Fabric</div>
      <div class="cc-fabric-grid" id="cc-fabric-grid" role="listbox" aria-label="Available fabrics">
        <!-- JS renders fabric cards here -->
      </div>
    </div>

    <div class="cc-modal__colours">
      <div class="cc-modal__section-title">Choose Colour</div>
      <div class="cc-colour-grid" id="cc-colour-grid" role="listbox" aria-label="Available colours">
        <div class="cc-colour-empty">Select a fabric to see colours</div>
      </div>
      
      <div class="cc-modal__footer">
        <button class="cc-modal__confirm" id="cc-modal-confirm" type="button" disabled>
          Confirm choices
        </button>
      </div>
    </div>
  </div>
</div>
